{
  "name": "@fro-bot/.github",
  "version": "0.0.0",
  "private": true,
  "description": "Community health files and automated control center for @fro-bot",
  "keywords": [
    "actions",
    "ai",
    "automation",
    "github-actions",
    "fro-bot",
    "renovate-config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fro-bot/.github.git"
  },
  "license": "MIT",
  "author": "Marcus R. Brown <git@mrbro.dev> (https://mrbro.dev/)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "bun install",
    "build": "bun scripts/build-wiki-write-core.ts",
    "check:wiki-write-core-dist": "bun scripts/build-wiki-write-core.ts --check",
    "check:mutation-guards": "bun scripts/check-mutation-guards.ts",
    "check-types": "bun run build && tsc --noEmit --project ./tsconfig.json",
    "coverage": "bun run build && vitest run --coverage",
    "fix": "bun run lint --fix",
    "check:md-links": "bun scripts/check-md-links.ts",
    "check:renovate-config": "node scripts/install-renovate.ts && node scripts/check-renovate-config.ts",
    "check:override-floors": "bun scripts/check-override-floors.ts",
    "check:solutions-examples": "bun scripts/check-solutions-examples.ts",
    "lint": "bun run check:md-links && bun run check:override-floors && bun run check:solutions-examples && eslint",
    "test": "bun run build && vitest run",
    "test:watch": "bun run build && echo 'test:watch builds dist once; rerun after source changes' && vitest"
  },
  "prettier": "@bfra.me/prettier-config/120-proof",
  "overrides": {
    "ajv@8": "8.20.0",
    "brace-expansion": ">=5.0.12",
    "fast-uri": ">=4.1.3",
    "flatted": ">=3.4.2",
    "minimatch": ">=10.2.3",
    "nanoid": ">=3.3.18 <4",
    "picomatch": ">=4.0.4",
    "postcss": ">=8.5.18",
    "qs": ">=6.15.2",
    "source-map-js": ">=1.2.2",
    "undici": ">=8.12.2",
    "vite": ">=8.3.3",
    "yaml": ">=2.8.3",
    "zod@4": ">=4.6.6"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@bfra.me/eslint-config": "0.54.0",
    "@bfra.me/prettier-config": "0.16.0",
    "@bfra.me/tsconfig": "0.13.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.15",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-erasable-syntax-only": "0.7.1",
    "eslint-plugin-node-dependencies": "2.3.0",
    "eslint-plugin-prettier": "5.5.0",
    "jiti": "2.7.0",
    "prettier": "3.9.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver"
  ]
}
