{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "scripts/check-private-leak.ts",
    "scripts/check-wiki-authority.ts",
    "scripts/check-repo-onboarded.ts",
    "scripts/wiki-lockfile-gates.ts",
    "scripts/wiki-context-safety.ts",
    "scripts/build-wiki-write-core.ts",
    "packages/wiki-write-core/src/private-leak-adapter.ts",
    "packages/wiki-write-core/src/corrections.ts",
    "packages/wiki-write-core/src/corrections-survival.ts"
  ],
  "testFiles": [
    "scripts/check-private-leak.test.ts",
    "scripts/check-wiki-authority.test.ts",
    "scripts/check-repo-onboarded.test.ts",
    "scripts/wiki-lockfile-gates.test.ts",
    "scripts/wiki-context-safety.test.ts",
    "scripts/build-wiki-write-core.test.ts",
    "packages/wiki-write-core/src/private-leak-adapter.test.ts",
    "packages/wiki-write-core/src/corrections.test.ts",
    "packages/wiki-write-core/src/corrections-survival.test.ts"
  ],
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": null
  },
  "reporters": ["json", "clear-text"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "allowConsoleColors": false,
  "timeoutMS": 30000,
  "dryRunTimeoutMinutes": 5
}
