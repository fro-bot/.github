{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/core/src/github.ts",
    "packages/core/src/guards.ts",
    "packages/core/src/json.ts",
    "packages/core/src/output.ts",
    "packages/core/src/retry.ts",
    "packages/wiki-write-core/src/corrections-survival.ts",
    "packages/wiki-write-core/src/corrections.ts",
    "packages/wiki-write-core/src/private-leak.ts",
    "scripts/build-wiki-write-core.ts",
    "scripts/check-private-leak.ts",
    "scripts/check-wiki-authority.ts",
    "scripts/check-wiki-private-presence.ts",
    "scripts/merge-back-data.ts",
    "scripts/mutation-guards-reach.ts",
    "scripts/wiki-context-safety.ts",
    "scripts/wiki-lockfile-gates.ts"
  ],
  "testFiles": [
    "packages/core/src/github-loader.test.ts",
    "packages/core/src/github.test.ts",
    "packages/core/src/guards.test.ts",
    "packages/core/src/json.test.ts",
    "packages/core/src/output.test.ts",
    "packages/core/src/retry.test.ts",
    "packages/wiki-write-core/src/corrections-survival.test.ts",
    "packages/wiki-write-core/src/corrections.test.ts",
    "packages/wiki-write-core/src/private-leak-adapter.test.ts",
    "packages/wiki-write-core/src/private-leak.test.ts",
    "packages/wiki-write-core/src/wiki-write-core.test.ts",
    "scripts/build-wiki-write-core.test.ts",
    "scripts/check-private-leak.test.ts",
    "scripts/check-wiki-authority.test.ts",
    "scripts/check-wiki-private-presence.test.ts",
    "scripts/merge-back-data.test.ts",
    "scripts/mutation-guards-reach.test.ts",
    "scripts/wiki-context-safety.test.ts",
    "scripts/wiki-lockfile-gates.test.ts"
  ],
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": null
  },
  "reporters": ["json", "clear-text"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [".worktrees"],
  "allowConsoleColors": false,
  "timeoutMS": 30000,
  "dryRunTimeoutMinutes": 8
}
