# Dependencies
node_modules

# Environment & secrets
.env
.env.*
!.env.example

# OS artifacts
.DS_Store
Thumbs.db

# Editor state
*.swp
*.swo
*~

# Build output
dist
*.tsbuildinfo
# The wiki-site local plugin ships committed plain-JS dist/ by design —
# Quartz v5 symlinks local plugins without building them.
!quartz-site/local-plugin/dist/

# The wiki-write-core package ships committed ESM build output.
!packages/wiki-write-core/dist/
!packages/wiki-write-core/dist/**

# Test output
coverage
.vitest-cache

# Mutation testing sandbox and reports (Stryker)
/.stryker-tmp/
/reports/

# Local agent artifacts
.context/
.review/

# Wiki lint local artifacts (CI uploads them to actions/upload-artifact; never tracked in git)
wiki-lint-report.md
wiki-lint-report.json

# Opencode
!.opencode/
.opencode/*
!.opencode/themes/
!.opencode/tui.json

# Runtime artifact written by the survey workflow's correction-context step
.github/corrections-context.json

# Build staging/backup dirs; siblings of dist/ so the atomic rename stays on one filesystem
packages/wiki-write-core/.wiki-write-core-dist-*
