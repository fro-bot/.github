# Dependencies
node_modules

# Environment & secrets
.env
.env.*
!.env.example

# OS artifacts
.DS_Store
Thumbs.db

# Editor state
*.swp
*.swo
*~

# Build output
dist
*.tsbuildinfo
# The wiki-site local plugin ships committed plain-JS dist/ by design —
# Quartz v5 symlinks local plugins without building them.
!quartz-site/local-plugin/dist/

# The wiki-write-core package commits one file under dist/: gate-contract.json, which
# fro-bot/dashboard fetches from main. Its build output is staged outside the tree.
!packages/wiki-write-core/dist/
packages/wiki-write-core/dist/*
!packages/wiki-write-core/dist/gate-contract.json

# Test output
coverage
.vitest-cache

# Mutation testing sandbox and reports (Stryker)
/.stryker-tmp/
/reports/

# Local agent artifacts
.context/
.review/

# Repo-local git worktrees (other branches' checkouts; never tracked, never scanned)
/.worktrees/

# Digest/bodies handoff dirs the capture workflows place inside the workspace for the agent
.capture-learnings/
.capture-patterns/
.drafted-solutions/

# Wiki lint local artifacts (CI uploads them to actions/upload-artifact; never tracked in git)
wiki-lint-report.md
wiki-lint-report.json

# Opencode
!.opencode/
.opencode/*
!.opencode/themes/
!.opencode/tui.json

# Runtime artifact written by the survey workflow's correction-context step
.github/corrections-context.json

# Build staging dirs; siblings of dist/ so the build output stays on one filesystem
packages/wiki-write-core/.wiki-write-core-dist-*
